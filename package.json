{
  "name": "pumpkin-model-studio",
  "version": "1.0.0",
  "private": true,
  "description": "南瓜快速瀏覽3D模型 Pumpkin Model Studio：看模型＋拆 UV 合體的網頁工具，雙擊 index.html 即開",
  "scripts": {
    "build": "node tools/inline-css.cjs && esbuild src/main.js --bundle --format=iife --minify --outfile=dist/app.js",
    "watch": "esbuild src/main.js --bundle --format=iife --outfile=dist/app.js --watch",
    "test:engine": "node --test engine-tests",
    "samples": "node tools/make-samples.cjs",
    "smoke": "node _crew/check/smoke.cjs"
  },
  "dependencies": {
    "three": "0.170.0",
    "three-mesh-bvh": "^0.8.3"
  },
  "devDependencies": {
    "esbuild": "~0.24.2"
  }
}
